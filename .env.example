# Copy to .env. Do not commit real credentials.
ENVIRONMENT=development

KAFKA_BOOTSTRAP_SERVERS=localhost:9092

OBJECT_STORE_URI=s3://cognitive-traffic
S3_ENDPOINT_URL=http://localhost:19000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1

POSTGRES_DSN=postgresql://postgres:postgres@localhost:15433/traffic_analytics
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
REDIS_URL=redis://localhost:6380/0

MLFLOW_TRACKING_URI=http://localhost:5000
MODEL_NAME=traffic-speed-quantiles

TOMTOM_API_KEY=
OPENWEATHER_API_KEY=

ALLOWED_LATENESS_SECONDS=300
FEATURE_VERSION=1
SCHEMA_VERSION=1
VITE_API_BASE_URL=http://localhost:18000

# Host ports; Docker-internal connections retain their service ports.
API_PORT=18000
FRONTEND_PORT=5173
POSTGRES_PORT=15433
KAFKA_PORT=9092
REDIS_PORT=6380
S3_PORT=19000
S3_CONSOLE_PORT=19001
GRAFANA_PORT=13000
PROMETHEUS_PORT=19090
ALERTMANAGER_PORT=19093
ONCALL_PORT=19095
